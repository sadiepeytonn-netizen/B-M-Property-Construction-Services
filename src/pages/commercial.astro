---
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ContactForm from '../components/ContactForm.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
import { commercialServices } from '../data/services';
import { commercialFaqs, faqSchema, breadcrumbSchema } from '../data/faqs';
import { imgPath, img } from '../data/images';
import { commercialPairs } from '../data/sliders';
---
<Base
  title="Commercial Framing, Drywall & Repairs | B&M Titusville, FL"
  description="Metal stud framing, commercial drywall finishing, and repairs and maintenance for offices and retail in Titusville, Brevard County and Orlando. (321) 890-7839."
  image={img('office-after')}
  schema={[
    faqSchema(commercialFaqs),
    breadcrumbSchema(site.url, [{ name: 'Home', path: '/' }, { name: 'Commercial', path: '/commercial/' }]),
  ]}
>
  <section class="chero">
    <div class="wrap chero__grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Commercial</li></ol></nav>
        <h1>Commercial framing, drywall and repairs</h1>
        <p>Interior work for offices, retail units and rental buildings across Brevard County and Orlando. We work for owners and property managers, or as a framing and finishing sub for your general contractor.</p>
        <div class="chero__ctas">
          <a class="btn btn--tape" href="#estimate">Request a quote</a>
          <a class="btn btn--ghost" href={site.phoneHref}>Call {site.phone}</a>
        </div>
      </div>
      <BeforeAfter pairs={commercialPairs} id="commercial-page" eager dark />
    </div>
  </section>

  <section class="section">
    <div class="wrap rows">
      {commercialServices.map((s) => (
        <article class="row">
          <img src={imgPath(s.image)} alt={s.imageAlt} width="1168" height="880" loading="lazy" />
          <div>
            <h2><a href={`/services/${s.slug}/`}>{s.name}</a></h2>
            <p>{s.intro[0]}</p>
            <ul class="ticks">{s.includes.slice(0, 4).map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn--ink" href={`/services/${s.slug}/`}>More on {s.name.toLowerCase()}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--tile">
    <div class="wrap who">
      <div>
        <h2>Who we work with</h2>
        <p>Commercial work comes to us a few different ways. Whichever one fits, you get one point of contact and a written quote before anything starts.</p>
      </div>
      <dl class="who__list">
        <div><dt>General contractors</dt><dd>Metal stud framing and drywall finishing on tenant improvements and remodels, to your drawings and schedule.</dd></div>
        <div><dt>Property managers</dt><dd>Unit turnovers, punch lists and recurring maintenance across your buildings.</dd></div>
        <div><dt>Business owners</dt><dd>New offices and partitions, repairs, and updates to the space you lease or own.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Commercial questions</h2>
      <Faq items={commercialFaqs} />
    </div>
  </section>

  <section class="section section--tile" id="estimate">
    <div class="wrap est">
      <div>
        <h2>Request a commercial quote</h2>
        <p>Send the scope, the address and your timeline. Drawings or photos help. Or call <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <ContactForm service={commercialServices[0].name} />
    </div>
  </section>
</Base>

<style>
  .chero { background: var(--ink); color: #d6e1e7; padding: clamp(24px, 4vw, 48px) 0 clamp(40px, 6vw, 72px); }
  .chero__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .chero h1 { color: #fff; }
  .chero p { font-size: 1.12rem; }
  .chero .crumbs { color: #9fb1bd; padding: 0 0 20px; }
  .chero .crumbs a { color: #cfe0e6; }
  .chero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .chero__ctas .btn--ghost { color: #fff; }

  .rows { display: grid; gap: 64px; }
  .row { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(24px, 4vw, 48px); align-items: center; }
  .row:nth-child(even) img { order: 2; }
  .row img { aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); width: 100%; }
  .row h2 a { color: var(--ink); text-decoration: none; }
  .row h2 a:hover { color: var(--river); }

  .who { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(28px, 5vw, 64px); }
  .who__list { margin: 0; border-top: 2px solid var(--ink); }
  .who__list div { padding: 16px 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 12em 1fr; gap: 16px; }
  .who__list dt { font-weight: 800; color: var(--ink); font-variation-settings: 'wdth' 110; }
  .who__list dd { margin: 0; color: var(--muted); }

  .est { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(28px, 5vw, 64px); }

  @media (max-width: 900px) {
    .chero__grid, .who, .est { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; }
    .row:nth-child(even) img { order: 0; }
  }
  @media (max-width: 560px) { .who__list div { grid-template-columns: 1fr; gap: 4px; } }
</style>
