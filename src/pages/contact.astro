---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../data/faqs';
---
<Base
  title="Free Estimates & Contact | B&M Titusville, FL"
  description="Request a free estimate for kitchen remodeling, bathroom remodeling, flooring or home repairs in Titusville, Brevard County and Orlando. Call (321) 890-7839."
  schema={[breadcrumbSchema(site.url, [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }])]}
>
  <header class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Contact</li></ol></nav>
      <h1>Get a free estimate</h1>
      <p>Tell us about the job. We will get back to you to set up a time to see the space.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap two">
      <ContactForm />
      <aside>
        <p class="big"><a href={site.phoneHref}>{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>Based in {site.city}, {site.region}. Serving Brevard County and the Orlando area.</p>
        <p><a href={site.facebook} target="_blank" rel="noopener">Facebook</a> · <a href={site.googleProfile} target="_blank" rel="noopener">Google reviews</a></p>
        <MapEmbed query="B&M Property Construction Services, Titusville, FL" zoom={10} title="Map of Titusville, Florida" />
      </aside>
    </div>
  </section>
</Base>
<style>
  .two { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .big { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 850; font-variation-settings: var(--wide); margin-bottom: .2em; }
  .big a { color: var(--ink); text-decoration: none; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
</style>
