---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Request received | B&M Property Construction Services" description="Thanks for your estimate request." noindex>
  <section class="section">
    <div class="wrap">
      <h1>Request received</h1>
      <p class="lede">Thanks — we have your details and will get back to you soon to set up a time. If it is urgent, call <a href={site.phoneHref}>{site.phone}</a>.</p>
      <p><a class="btn btn--ink" href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>
