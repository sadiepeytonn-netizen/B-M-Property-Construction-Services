---
interface Props { query: string; zoom?: number; title: string; }
const { query, zoom = 9, title } = Astro.props;
const src = `https://maps.google.com/maps?q=${encodeURIComponent(query)}&z=${zoom}&output=embed`;
---
<div class="map">
  <iframe src={src} title={title} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>
<style>
  .map { aspect-ratio: 4 / 3; background: var(--grout); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .map iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
